# Rust Lovable - Environment Configuration

# AI Provider Settings
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama3-8b-8192

# Local AI (Ollama, etc.)
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama2

# Database Settings
DATABASE_URL=sqlite://./data/rust-lovable.db
# Or for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/rust_lovable

# Development Settings
RUST_LOG=info
RUST_BACKTRACE=1

# Platform Settings
DEFAULT_PLATFORM=universal
ENABLE_HOT_RELOAD=true

# Build Settings
BUILD_DIR=./dist
ASSETS_DIR=./assets

# API Keys for External Services
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
E2B_API_KEY=e2b-your-e2b-key-here

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_CROSS_PLATFORM=true
ENABLE_REALTIME_SYNC=false