@ECHO off
REM llama.cpp Server Wrapper - Generated by NOA bootstrap
REM Runs llama-server in the CURRENT terminal window (no new window)
REM Constitution §3.1: Self-contained installation
SETLOCAL EnableDelayedExpansion

SET "NOA_ROOT=%~dp0.."

REM Check NOA-local build locations (in order of preference)
SET "LLAMA_BUILD=%NOA_ROOT%\opt\llama.cpp\build\bin\Release\llama-server.exe"
IF EXIST "%LLAMA_BUILD%" (
    "%LLAMA_BUILD%" %*
    exit /b %ERRORLEVEL%
)

SET "LLAMA_BUILD2=%NOA_ROOT%\opt\llama.cpp\build\bin\llama-server.exe"
IF EXIST "%LLAMA_BUILD2%" (
    "%LLAMA_BUILD2%" %*
    exit /b %ERRORLEVEL%
)

SET "LLAMA_BUILD3=%NOA_ROOT%\opt\llama.cpp\build\Release\llama-server.exe"
IF EXIST "%LLAMA_BUILD3%" (
    "%LLAMA_BUILD3%" %*
    exit /b %ERRORLEVEL%
)

SET "LLAMA_ROOT=%NOA_ROOT%\opt\llama.cpp\llama-server.exe"
IF EXIST "%LLAMA_ROOT%" (
    "%LLAMA_ROOT%" %*
    exit /b %ERRORLEVEL%
)

REM Check bin directory for pre-built binary
SET "LLAMA_BIN=%NOA_ROOT%\opt\llama-server.exe"
IF EXIST "%LLAMA_BIN%" (
    "%LLAMA_BIN%" %*
    exit /b %ERRORLEVEL%
)

echo [ERROR] llama-server not found.
echo.
echo Build llama.cpp:
echo   cd %NOA_ROOT%\opt\llama.cpp
echo   cmake -B build
echo   cmake --build build --config Release
echo.
echo Or download pre-built: https://github.com/ggerganov/llama.cpp/releases
exit /b 1

