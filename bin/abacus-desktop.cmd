@ECHO off
REM Abacus Desktop App Wrapper - Generated by NOA bootstrap
REM Launches Abacus Desktop from self-contained installation (Constitution §3.1)
SETLOCAL EnableDelayedExpansion

SET "NOA_ROOT=%~dp0.."
SET "ABACUS_DESKTOP=%NOA_ROOT%\opt\abacus\AbacusAI\AbacusAI.exe"

