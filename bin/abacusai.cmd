@ECHO off
REM Abacus AI CLI Wrapper - Generated by NOA bootstrap
REM Points to self-contained npm-global installation (Constitution §3.1)
SETLOCAL EnableDelayedExpansion

SET "NOA_ROOT=%~dp0.."
SET "NODE_EXE=%NOA_ROOT%\opt\node\node.exe"
SET "NPM_BIN=%NOA_ROOT%\opt\dev-tools\npm-global\node_modules\.bin\abacusai.cmd"
SET "ABACUS_CLI=%NOA_ROOT%\opt\dev-tools\npm-global\node_modules\@abacus-ai\cli\dist\index.js"

REM First try npm .bin wrapper (preferred)
IF EXIST "%NPM_BIN%" (
    "%NPM_BIN%" %*
    exit /b %ERRORLEVEL%
)

REM Fallback to direct node execution
IF NOT EXIST "%NODE_EXE%" (
    echo [ERROR] Node.js not found at %NODE_EXE%
    echo Run bootstrap to install Node.js first.
    exit /b 1
)

IF NOT EXIST "%ABACUS_CLI%" (
    echo [ERROR] Abacus AI CLI not found at %ABACUS_CLI%
    echo Run: npm install -g @abacus-ai/cli --prefix "%NOA_ROOT%\opt\dev-tools\npm-global"
    exit /b 1
)

"%NODE_EXE%" "%ABACUS_CLI%" %*
