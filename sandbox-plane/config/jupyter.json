{
    "version": "1.0.0",
    "description": "NOA Sandbox-Plane Jupyter Environment Configuration",
    "lastUpdated": "2025-12-11T00:00:00Z",

    "jupyter": {
        "kernel": {
            "name": "noa-base",
            "displayName": "NOA Python (conda-forge)",
            "python": "/opt/conda/bin/python",
            "source": "conda-forge",
            "packages": {
                "ipykernel": ">=7.1.0",
                "nb_conda_kernels": ">=2.5.1"
            }
        },
        "kernelspecPath": "/home/codespace/.local/share/jupyter/kernels/noa-base"
    },

    "conda": {
        "prefix": "/opt/conda",
        "channels": ["conda-forge"],
        "environment": "base"
    },

    "portability": {
        "description": "This configuration ensures Jupyter kernels are portable across environments",
        "benefits": [
            "Reproducible across machines",
            "Isolated from host Python",
            "Version-pinned dependencies via conda-forge",
            "nb_conda_kernels auto-discovers conda envs as kernels"
        ]
    },

    "sandboxIntegration": {
        "description": "Integration with NKAL sandbox mode",
        "isolationLevel": "medium",
        "capabilities": [
            "Execute untrusted notebooks in sandbox",
            "Automatic kernel discovery via nb_conda_kernels",
            "Per-environment package isolation"
        ]
    }
}
