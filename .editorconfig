root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 2
end_of_line = crlf

[*.{rs,go}]
indent_size = 4


