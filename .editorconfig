# EditorConfig - Cross-IDE Configuration
# Constitution §3.1 Compliance - Consistent formatting across all editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Rust files
[*.rs]
indent_size = 4

# TypeScript/JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON/YAML/TOML configuration
[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefile (must use tabs)
[Makefile]
indent_style = tab

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# PowerShell
[*.{ps1,psm1,psd1}]
indent_size = 4

# Python
[*.py]
indent_size = 4

# Go (uses tabs by convention)
[*.go]
indent_style = tab

# HTML/CSS/SCSS
[*.{html,htm,css,scss,sass,less}]
indent_size = 2

# Docker
[{Dockerfile,*.dockerfile,docker-compose*.{yaml,yml}}]
indent_size = 2
