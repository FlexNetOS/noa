# NOA Environment Profile (TEMPLATE)
#
# This file is a template and is NOT meant to be executed as-is.
# The real `noa-profile.ps1` is generated by:
#   .\scripts\setup\setup-noa.ps1
#
# Why:
# - `noa-profile.ps1` is machine/path-specific and therefore must not be committed.
# - Use `noa-env.ps1` for a drive-agnostic, auto-detecting environment loader if needed.

# Example (generated output will look similar to this):
$env:NOA_ROOT = "N:\\noa"
$env:NOA_REPOS = "$env:NOA_ROOT\\repos"
$env:NOA_CONTAINERS = "$env:NOA_ROOT\\containers"
$env:NOA_WORKSPACE = "$env:NOA_ROOT\\workspace"
$env:NOA_CONFIG = "$env:NOA_ROOT\\config"
$env:NOA_SCRIPTS = "$env:NOA_ROOT\\scripts"

# MCP / Provider Secrets (DO NOT COMMIT)
#
# The real `noa-profile.ps1` is generated locally and should load secrets from a local-only file.
# Recommended location:
#   %USERPROFILE%\.noa\secrets.ps1
#
# Example secrets file contents (create locally):
#   $env:GITHUB_PERSONAL_ACCESS_TOKEN = "github_pat_..."
#
# Never store secrets in repo files (including `.vscode/*` or `.cursor/*`).

function cda { Set-Location $env:NOA_ROOT }
function cdr { Set-Location $env:NOA_REPOS }
function cdw { Set-Location $env:NOA_WORKSPACE }

Write-Host "NOA environment loaded" -ForegroundColor Green


