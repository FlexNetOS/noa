{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noa.dev/schema/skill.json",
  "title": "Skill Schema",
  "description": "Defines reusable agent skills",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "What this skill does"
    },
    "type": {
      "type": "string",
      "enum": [
        "planning",
        "analysis",
        "generation",
        "review",
        "search",
        "execution"
      ]
    },
    "parameters": {
      "type": "object",
      "description": "Input parameters for the skill"
    },
    "returns": {
      "type": "object",
      "description": "Output format"
    },
    "implementation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "prompt",
            "function",
            "workflow"
          ]
        },
        "casRef": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required tools or other skills"
    },
    "casHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}