{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noa.dev/schema/world.json",
  "title": "World Model Schema",
  "description": "Defines the world model for agent reasoning",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "context": {
      "type": "object"
    },
    "casHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}