{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noa.dev/schema/tool.json",
  "title": "Tool Schema",
  "description": "Defines executable tools for agents",
  "type": "object",
  "required": [
    "id",
    "name",
    "function"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "api",
            "function",
            "command",
            "rust"
          ]
        },
        "handler": {
          "type": "string"
        },
        "sandboxed": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required system permissions"
    },
    "casHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}