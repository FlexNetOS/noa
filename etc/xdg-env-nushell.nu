# NOA XDG Environment Variables - Constitution Â§3.1 Compliant
# Add to N:\noa\etc\nushell\env.nu

$env.XDG_CONFIG_HOME = "N:/noa\etc"
$env.XDG_CACHE_HOME = "N:/noa\cache"
$env.XDG_DATA_HOME = "N:/noa\data"
$env.XDG_STATE_HOME = "N:/noa\data\state"

# Program-specific redirects
$env.ANDROID_USER_HOME = "N:/noa\data\android"
$env.AZURE_CONFIG_DIR = "N:/noa\etc\azure"
$env.DOCKER_CONFIG = "N:/noa\etc\docker"
$env.DOTNET_CLI_HOME = "N:/noa\data\dotnet"
$env.NUGET_PACKAGES = "N:/noa\cache\nuget\packages"
$env.GIT_CONFIG_GLOBAL = "N:/noa\etc\git\config"
$env.GNUPGHOME = "N:/noa\data\gnupg"
$env.LESSHISTFILE = "N:/noa\data\state\less\history"
$env.NPM_CONFIG_USERCONFIG = "N:/noa\etc\npm\npmrc"
$env.NPM_CONFIG_CACHE = "N:/noa\cache\npm"
$env.PYTHON_HISTORY = "N:/noa\data\state\python\history"
$env.RUSTUP_HOME = "N:/noa\data\rustup"
$env.CARGO_HOME = "N:/noa\data\cargo"
$env.OLLAMA_HOME = "N:/noa\data\ollama"
$env.OLLAMA_MODELS = "N:/noa\cache\ollama\models"
