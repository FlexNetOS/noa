{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": "1.0.0",
    "description": "NOA Kernel Modules Configuration",
    "lastUpdated": "2025-01-01T00:00:00Z",

    "requiredModules": {
        "linux": [
            {
                "name": "tun",
                "description": "TUN/TAP for P2P and VPN networking",
                "loadCommand": "modprobe tun",
                "checkCommand": "lsmod | grep ^tun",
                "required": true
            },
            {
                "name": "ip_tables",
                "description": "iptables for firewall rules",
                "loadCommand": "modprobe ip_tables",
                "checkCommand": "lsmod | grep ^ip_tables",
                "required": true
            },
            {
                "name": "nf_conntrack",
                "description": "Connection tracking for NAT",
                "loadCommand": "modprobe nf_conntrack",
                "checkCommand": "lsmod | grep ^nf_conntrack",
                "required": true
            },
            {
                "name": "bridge",
                "description": "Network bridging for containers",
                "loadCommand": "modprobe bridge",
                "checkCommand": "lsmod | grep ^bridge",
                "required": true
            },
            {
                "name": "wireguard",
                "description": "WireGuard for encrypted P2P",
                "loadCommand": "modprobe wireguard",
                "checkCommand": "lsmod | grep ^wireguard",
                "required": false
            },
            {
                "name": "veth",
                "description": "Virtual ethernet for containers",
                "loadCommand": "modprobe veth",
                "checkCommand": "lsmod | grep ^veth",
                "required": false
            }
        ],
        "windows": [
            {
                "name": "tap0901",
                "description": "TAP-Windows Adapter for VPN/P2P",
                "driver": "tap0901.sys",
                "installCommand": "choco install openvpn -y",
                "checkCommand": "Get-WindowsDriver -Online | Where-Object { $_.Driver -like '*tap*' }",
                "required": false
            },
            {
                "name": "hyperv_switch",
                "description": "Hyper-V Virtual Switch",
                "feature": "Microsoft-Hyper-V",
                "installCommand": "Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All",
                "checkCommand": "(Get-WindowsOptionalFeature -FeatureName Microsoft-Hyper-V-All -Online).State",
                "required": false
            }
        ],
        "macos": [
            {
                "name": "utun",
                "description": "macOS userspace TUN driver (built-in)",
                "builtIn": true,
                "required": true
            }
        ]
    },

    "loadOrder": [
        "ip_tables",
        "nf_conntrack", 
        "bridge",
        "tun",
        "veth",
        "wireguard"
    ],

    "autoLoad": {
        "enabled": true,
        "onBootstrap": true,
        "requireRoot": true,
        "fallbackToUserspace": true
    },

    "stateFile": "sys/kernel/modules/loaded.json",

    "parameters": {
        "tun": {
            "deviceCount": 8
        },
        "nf_conntrack": {
            "hashsize": 16384,
            "max": 65536
        }
    }
}
