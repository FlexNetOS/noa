{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": "1.0.0",
    "description": "NOA Container Mode Configuration",
    "lastUpdated": "2025-01-01T00:00:00Z",

    "image": {
        "name": "noa-runtime",
        "registry": "ghcr.io/noa-project",
        "tag": "latest",
        "dockerfile": "containers/oci/Dockerfile.runtime"
    },

    "runtimes": {
        "docker": {
            "preferRootless": true,
            "socketPath": {
                "linux": "/var/run/docker.sock",
                "macos": "/var/run/docker.sock",
                "windows": "//./pipe/docker_engine"
            }
        },
        "podman": {
            "rootless": true,
            "socketPath": {
                "linux": "${XDG_RUNTIME_DIR}/podman/podman.sock"
            }
        },
        "containerd": {
            "namespace": "noa",
            "socketPath": "/run/containerd/containerd.sock"
        }
    },

    "resources": {
        "memoryLimit": "2g",
        "cpuLimit": "2.0",
        "pidsLimit": 1000,
        "noNewPrivileges": true
    },

    "networking": {
        "mode": "bridge",
        "networkName": "noa-network",
        "ports": [
            {
                "container": 8080,
                "host": 8080,
                "protocol": "tcp",
                "description": "API server"
            },
            {
                "container": 4001,
                "host": 4001,
                "protocol": "tcp",
                "description": "P2P libp2p"
            },
            {
                "container": 50051,
                "host": 50051,
                "protocol": "tcp",
                "description": "gRPC"
            }
        ]
    },

    "volumes": [
        {
            "name": "noa-data",
            "hostPath": "${NOA_ROOT}/data",
            "containerPath": "/noa/data",
            "mode": "rw"
        },
        {
            "name": "noa-config",
            "hostPath": "${NOA_ROOT}/config",
            "containerPath": "/noa/config",
            "mode": "ro"
        }
    ],

    "securityOptions": {
        "seccomp": "containers/oci/seccomp-profile.json",
        "apparmor": "noa-container-profile",
        "noNewPrivileges": true,
        "readOnlyRootfs": false,
        "capDrop": ["ALL"],
        "capAdd": ["NET_BIND_SERVICE", "NET_ADMIN"]
    },

    "healthCheck": {
        "command": ["curl", "-f", "http://localhost:8080/health"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "10s"
    },

    "labels": {
        "org.opencontainers.image.title": "NOA Runtime",
        "org.opencontainers.image.description": "NOA Autonomous AI Assistant Container",
        "org.opencontainers.image.vendor": "NOA Project",
        "org.opencontainers.image.source": "https://github.com/noa-project/noa"
    }
}
