{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": "1.0.0",
    "description": "NOA Sandbox Mode Configuration",
    "lastUpdated": "2025-01-01T00:00:00Z",

    "description": "Per-operation isolation for ephemeral, single-task environments",
    "useCases": [
        "per_operation_isolation",
        "ephemeral_environments", 
        "quick_throwaway_tasks",
        "untrusted_tool_execution"
    ],

    "runtimes": {
        "windows-sandbox": {
            "platform": "windows",
            "configFile": "sys/kernel/windows/sandbox/noa.wsb",
            "requirements": ["Windows 10/11 Pro or Enterprise", "Windows Sandbox feature enabled"],
            "features": {
                "vGPU": true,
                "networking": true,
                "audioInput": false,
                "videoInput": false,
                "protectedClient": true,
                "printerRedirection": false,
                "clipboardRedirection": true
            }
        },
        "bubblewrap": {
            "platform": "linux",
            "binary": "/usr/bin/bwrap",
            "defaultArgs": [
                "--unshare-all",
                "--share-net",
                "--die-with-parent",
                "--new-session"
            ],
            "requirements": ["bubblewrap package installed"]
        },
        "firejail": {
            "platform": "linux",
            "binary": "/usr/bin/firejail",
            "profile": "sys/kernel/linux/sandbox/noa.profile",
            "requirements": ["firejail package installed"]
        },
        "app-sandbox": {
            "platform": "macos",
            "entitlements": "sys/kernel/macos/sandbox/noa.entitlements",
            "requirements": ["macOS 10.15+"]
        }
    },

    "isolation": {
        "filesystem": {
            "mode": "overlay",
            "tmpfsSize": "512M",
            "allowedPaths": [
                {
                    "path": "${NOA_ROOT}/data",
                    "mode": "rw"
                },
                {
                    "path": "${NOA_ROOT}/config",
                    "mode": "ro"
                }
            ],
            "blockedPaths": [
                "/etc/passwd",
                "/etc/shadow",
                "${HOME}/.ssh",
                "${HOME}/.gnupg"
            ]
        },
        "network": {
            "enabled": true,
            "loopbackOnly": false,
            "allowedPorts": [8080, 4001, 50051]
        },
        "ipc": {
            "sharedMemory": false,
            "messageQueues": false,
            "semaphores": false
        },
        "process": {
            "pidsLimit": 100,
            "rlimitAs": "2G",
            "rlimitFsize": "100M",
            "noNewPrivileges": true
        }
    },

    "timeouts": {
        "default": "5m",
        "maxExecution": "30m",
        "idleShutdown": "1m"
    },

    "cleanup": {
        "autoCleanup": true,
        "preserveLogs": true,
        "logRetention": "1h"
    },

    "security": {
        "seccompFilter": "strict",
        "syscallWhitelist": [
            "read", "write", "open", "close", "stat", "fstat", "lstat",
            "poll", "lseek", "mmap", "mprotect", "munmap", "brk",
            "ioctl", "access", "pipe", "select", "sched_yield",
            "dup", "dup2", "socket", "connect", "accept", "sendto", "recvfrom",
            "bind", "listen", "getsockname", "getpeername", "socketpair",
            "shutdown", "clone", "fork", "vfork", "execve", "exit", "wait4",
            "kill", "getpid", "getppid", "getuid", "geteuid", "getgid", "getegid",
            "getcwd", "chdir", "rename", "mkdir", "rmdir", "unlink"
        ]
    }
}
