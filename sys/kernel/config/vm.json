{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": "1.0.0",
    "description": "NOA VM Mode Configuration",
    "lastUpdated": "2025-01-01T00:00:00Z",

    "vmImage": {
        "base": "alpine-linux",
        "kernelVersion": "6.6-lts",
        "maxSize": "500MB",
        "targetBootTime": "<3s",
        "formats": {
            "qcow2": "sys/kernel/images/noa-linux.qcow2",
            "vhdx": "sys/kernel/images/noa-linux.vhdx",
            "dmg": "sys/kernel/images/noa-linux.dmg"
        }
    },

    "resources": {
        "minMemoryMB": 512,
        "defaultMemoryMB": 2048,
        "maxMemoryMB": 8192,
        "minCpuCores": 1,
        "defaultCpuCores": 2,
        "maxCpuCores": 8,
        "diskSizeGB": 10
    },

    "kernelModules": [
        {
            "name": "tun",
            "description": "TUN/TAP for P2P tunneling",
            "required": true
        },
        {
            "name": "bridge",
            "description": "Network bridging",
            "required": true
        },
        {
            "name": "nf_tables",
            "description": "Firewall/NAT",
            "required": true
        },
        {
            "name": "wireguard",
            "description": "Encrypted P2P",
            "required": false
        }
    ],

    "networking": {
        "mode": "bridged",
        "enableNAT": true,
        "p2pPort": 4001,
        "apiPort": 8080,
        "grpcPort": 50051
    },

    "hypervisors": {
        "hyper-v": {
            "platform": "windows",
            "vmSwitch": "Default Switch",
            "generation": 2,
            "secureBootEnabled": false,
            "launchScript": "sys/kernel/windows/hyperv/noa-vm.ps1"
        },
        "kvm-qemu": {
            "platform": "linux",
            "enableKVM": true,
            "machineType": "q35",
            "cpuModel": "host",
            "launchScript": "sys/kernel/linux/vm/noa-vm.sh"
        },
        "virtualization-framework": {
            "platform": "macos",
            "rosettaEnabled": true,
            "launchScript": "sys/kernel/macos/vm/noa-vm.sh"
        }
    },

    "mounts": {
        "description": "Host directories mounted into VM",
        "entries": [
            {
                "name": "noa-data",
                "hostPath": "${NOA_ROOT}/data",
                "guestPath": "/noa/data",
                "mode": "rw"
            },
            {
                "name": "noa-config",
                "hostPath": "${NOA_ROOT}/config",
                "guestPath": "/noa/config",
                "mode": "ro"
            },
            {
                "name": "noa-logs",
                "hostPath": "${NOA_ROOT}/data/logs",
                "guestPath": "/noa/logs",
                "mode": "rw"
            }
        ]
    },

    "security": {
        "vmEscapePrevention": true,
        "minimalAttackSurface": true,
        "memoryIsolation": "hardware-enforced",
        "networkIsolation": "virtual-adapters-only",
        "fileSystem": "copy-on-write-with-integrity"
    }
}
