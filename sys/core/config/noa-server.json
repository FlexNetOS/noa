{
  "$schema": "https://noa.local/schemas/noa-server.json",
  "database": {
    "primary": {
      "driver": "sqlite",
      "max_connections": 10,
      "path": "${NOA_ROOT}/data/noa.db"
    }
  },
  "logging": {
    "format": "json",
    "level": "info",
    "output": "${NOA_ROOT}/logs/noa.log",
    "rotate": {
      "enabled": true,
      "max_files": 10,
      "max_size_mb": 100
    }
  },
  "observability": {
    "metrics": {
      "enabled": true,
      "endpoint": "/metrics"
    },
    "tracing": {
      "enabled": true,
      "endpoint": "http://localhost:4318"
    }
  },
  "server": {
    "host": "127.0.0.1",
    "max_connections": 100,
    "port": 8080,
    "timeout_secs": 30
  },
  "version": "1.0.0"
}