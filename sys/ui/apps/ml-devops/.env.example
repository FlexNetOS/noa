# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# AbacusAI API Key (for AI provider)
ABACUSAI_API_KEY="your_abacusai_api_key_here"

# Umami Analytics (Privacy-focused, GDPR-compliant)
# Get your Website ID from https://cloud.umami.is or your self-hosted instance
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your_umami_website_id_here"

# Umami Host (default: https://cloud.umami.is for cloud version)
# For self-hosted: https://your-umami-domain.com
NEXT_PUBLIC_UMAMI_HOST="https://cloud.umami.is"

# Umami Script Path (default: /script.js)
# For proxied setup: /stats/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_PATH="/script.js"

# Disable tracking on localhost (default: true)
# Set to "false" to enable tracking on localhost for testing
NEXT_PUBLIC_UMAMI_DISABLE_LOCALHOST_TRACKING="true"

# Umami Domains (optional, comma-separated list of domains to track)
# Example: "example.com,www.example.com"
NEXT_PUBLIC_UMAMI_DOMAINS=""

# NextAuth configsuration (for future authentication features)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"
