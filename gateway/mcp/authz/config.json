{
  "version": "1.0.0",
  "description": "Capability-based authorization for MCP tool calls",
  "metadata": {
    "version": "1.0.0",
    "description": "RBAC and capability enforcement for gateway",
    "updated_at": "2026-01-02T00:00:00Z"
  },
  "authz": {
    "engine": "agentgateway_rbac",
    "policies_path": "${NOA_ROOT}/configs/semantic/capabilities/",
    "default_policy": "deny",
    "cache_decisions": true,
    "decision_cache_ttl_seconds": 300
  },
  "capabilities": {
    "reasoning": {
      "description": "Complex reasoning and analysis tasks",
      "providers": ["remote/claude_code_cli", "local/llama_cpp"],
      "required_role": "agent",
      "budget_aware": true
    },
    "code_generation": {
      "description": "Code generation and completion",
      "providers": ["remote/codex_cli", "remote/copilot_bridge"],
      "required_role": "agent",
      "budget_aware": true
    },
    "code_execution": {
      "description": "Execute code in sandbox",
      "providers": ["remote/claude_code_cli"],
      "required_role": "agent",
      "sandbox_required": true,
      "audit_required": true
    },
    "file_operations": {
      "description": "Read/write file operations",
      "providers": ["remote/claude_code_cli"],
      "required_role": "agent",
      "sandbox_required": true,
      "audit_required": true,
      "scope": "sandbox_only"
    },
    "git_operations": {
      "description": "Git version control operations",
      "providers": ["remote/claude_code_cli", "local/git_cli"],
      "required_role": "agent",
      "audit_required": true
    },
    "embeddings": {
      "description": "Vector embedding generation",
      "providers": ["local/llama_cpp"],
      "required_role": "agent",
      "budget_aware": false
    },
    "tool_discovery": {
      "description": "Discover available tools",
      "providers": ["*"],
      "required_role": "user",
      "budget_aware": false
    }
  },
  "roles": {
    "admin": {
      "capabilities": ["*"],
      "description": "Full system access"
    },
    "agent": {
      "capabilities": [
        "reasoning",
        "code_generation",
        "code_execution",
        "file_operations",
        "git_operations",
        "embeddings",
        "tool_discovery"
      ],
      "description": "AI agent with standard capabilities"
    },
    "user": {
      "capabilities": ["tool_discovery"],
      "description": "Basic user access"
    },
    "readonly": {
      "capabilities": ["tool_discovery"],
      "description": "Read-only access"
    }
  },
  "authentication": {
    "enabled": true,
    "methods": ["api_key", "jwt", "mtls"],
    "default_role": "user",
    "require_auth": false,
    "local_bypass": true
  },
  "budget_enforcement": {
    "enabled": true,
    "budget_manager_config": "${NOA_ROOT}/providers/pool/budget-manager/config.json",
    "enforce_limits": true,
    "alert_on_threshold": true
  },
  "audit": {
    "enabled": true,
    "audit_log_path": "${NOA_ROOT}/data/logs/authz-audit.log",
    "log_all_decisions": true,
    "log_denied_requests": true,
    "sync_to_core_audit": true
  },
  "monitoring": {
    "enabled": true,
    "metrics_path": "${NOA_ROOT}/data/logs/authz-metrics.json",
    "track_authorization_rate": true,
    "track_denial_rate": true,
    "track_capability_usage": true
  }
}
