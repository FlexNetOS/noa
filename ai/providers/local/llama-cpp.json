{
  "name": "llama.cpp",
  "type": "local",
  "priority": 1,
  "enabled": true,
  "description": "llama.cpp - Priority 1 local inference engine (FR-039, spec.md)",
  "repository": "https://github.com/ggerganov/llama.cpp",
  "submodule": "${NOA_ROOT}/opt/llama.cpp",
  "cli": {
    "command": "llama-server",
    "package": "llama.cpp",
    "version": "latest",
    "llama-server": {
      "command": "llama-server",
      "binaryPath": {
        "windows": "${NOA_ROOT}/opt/llama.cpp/build/bin/Release/llama-server.exe",
        "unix": "${NOA_ROOT}/opt/llama.cpp/build/bin/llama-server"
      },
      "wrapper": {
        "windows": "${NOA_ROOT}/bin/llama-server.cmd",
        "unix": "${NOA_ROOT}/bin/llama-server"
      }
    },
    "llama-cli": {
      "command": "llama-cli",
      "binaryPath": {
        "windows": "${NOA_ROOT}/opt/llama.cpp/build/bin/Release/llama-cli.exe",
        "unix": "${NOA_ROOT}/opt/llama.cpp/build/bin/llama-cli"
      },
      "wrapper": {
        "windows": "${NOA_ROOT}/bin/llama-cli.cmd",
        "unix": "${NOA_ROOT}/bin/llama-cli"
      }
    }
  },
  "config": {
    "modelPath": "${NOA_ROOT}/ai/shared/models",
    "contextSize": 4096,
    "threads": 0,
    "gpuLayers": 0
  },
  "capabilities": {
    "textGeneration": true,
    "embeddings": true,
    "streaming": true,
    "functionCalling": false
  },
  "build": {
    "required": true,
    "commands": {
      "windows": "cd ${NOA_ROOT}/opt/llama.cpp && cmake -B build && cmake --build build --config Release",
      "unix": "cd ${NOA_ROOT}/opt/llama.cpp && cmake -B build && cmake --build build --config Release"
    },
    "note": "llama.cpp must be built from source. Run the build commands after cloning the submodule."
  },
  "sharedResourcePath": "${NOA_ROOT}/ai/shared",
  "sharedResources": {
    "workflows": "${NOA_ROOT}/ai/shared/workflows",
    "executionMemory": "${NOA_ROOT}/ai/shared/resources/execution-memory.db",
    "tools": "${NOA_ROOT}/ai/shared/tools",
    "agents": "${NOA_ROOT}/ai/shared/agents",
    "commands": "${NOA_ROOT}/ai/shared/commands",
    "prompts": "${NOA_ROOT}/ai/shared/prompts"
  },
  "systemPrompts": {
    "enabled": true,
    "inherit": ["ultrathink"],
    "promptPath": "${NOA_ROOT}/ai/shared/prompts"
  },
  "latency": {
    "target": "<2s"
  },
  "timeout": 30000
}
