# Structured output grammar for reports with findings and next actions.

root ::= ws summary_object ws
summary_object ::= "{" ws summary_field ws "," ws findings_field (ws "," ws actions_field)? ws "}"
summary_field ::= "\"summary\"" ws ":" ws string
findings_field ::= "\"findings\"" ws ":" ws "[" ws finding (ws "," ws finding)* ws "]"
actions_field ::= "\"next_actions\"" ws ":" ws "[" ws string (ws "," ws string)* ws "]"

finding ::= "{" ws "\"title\"" ws ":" ws string ws "," ws "\"detail\"" ws ":" ws string ws "," ws "\"severity\"" ws ":" ws severity ws "}"
severity ::= "\"low\"" | "\"medium\"" | "\"high\"" | "\"critical\""

string ::= "\"" characters "\""
characters ::= character*
character ::= unescaped | escape
unescaped ::= [^"\\\u0000-\u001F]
escape ::= "\\\"" | "\\\\" | "\\/" | "\\b" | "\\f" | "\\n" | "\\r" | "\\t"

ws ::= [ \t\n\r]*
