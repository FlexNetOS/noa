          "status": "template"
        },
        {
          "original": "cursor-agent",
          "provider": "cursor",
          "unified": "orchestration-agent",
          "location": "ai/shared/agents/orchestration-agent.json",
          "capabilities": ["orchestration", "context-aware", "multi-provider"],
          "status": "template"
