{
    "$schema": "https://noa.local/schemas/resource-registry.json",
    "version": "1.0.0",
    "description": "Central registry of all unified shared resources (§3.13)",
    "lastUpdated": "2025-12-17T00:00:00Z",
    "registry": {
        "agents": {
            "path": "ai/shared/agents/",
            "description": "AI agent definitions",
            "resources": [
                {
                    "name": "reasoning-agent",
                    "file": "reasoning-agent.json",
                    "type": "agent",
                    "providers": ["all"],
                    "description": "Advanced reasoning and analysis agent"
                },
                {
                    "name": "code-generation-agent",
                    "file": "code-generation-agent.json",
                    "type": "agent",
                    "providers": ["all"],
                    "description": "Code generation and refactoring agent"
                },
                {
                    "name": "inline-completion-agent",
                    "file": "inline-completion-agent.json",
                    "type": "agent",
                    "providers": ["all"],
                    "description": "Fast inline code completion agent"
                },
                {
                    "name": "orchestration-agent",
                    "file": "orchestration-agent.json",
                    "type": "agent",
                    "providers": ["all"],
                    "description": "Multi-provider orchestration agent"
                }
            ]
        },
        "tools": {
            "path": "ai/shared/tools/",
            "description": "MCP tool definitions",
            "resources": [
                {
                    "name": "reasoning-tool",
                    "file": "reasoning-tool.json",
                    "type": "tool",
                    "providers": ["all"],
                    "description": "Complex reasoning and analysis tool"
                },
                {
                    "name": "code-generation-tool",
                    "file": "code-generation-tool.json",
                    "type": "tool",
                    "providers": ["all"],
                    "description": "Code generation from natural language"
                }
            ]
        },
        "commands": {
            "path": "ai/shared/commands/",
            "description": "Shared command definitions",
            "resources": [
                {
                    "name": "ultrathink",
                    "file": "ultrathink.command.yaml",
                    "type": "command",
                    "providers": ["all"],
                    "description": "Deep thinking and reasoning command"
                }
            ]
        },
        "prompts": {
            "path": "ai/shared/prompts/",
            "description": "Prompt templates",
            "resources": [
                {
                    "name": "project-mgmt-prompt",
                    "file": "project-mgmt-prompt.md",
                    "type": "system",
                    "providers": ["all"]
                },
                {
                    "name": "startup-prmt",
                    "file": "startup-prmt.md",
                    "type": "system",
                    "providers": ["all"]
                },
                {
                    "name": "ultrathink-prompt",
                    "file": "ultrathink.prompt.md",
                    "type": "system",
                    "providers": ["all"]
                }
            ]
        },
        "workflows": {
            "path": "ai/shared/workflows/",
            "description": "Orchestration workflows",
            "resources": [
                {
                    "name": "code-analysis-workflow",
                    "file": "code-analysis-workflow.yaml",
                    "type": "workflow",
                    "providers": ["all"],
                    "description": "Multi-stage code analysis workflow"
                }
            ]
        },
        "skills": {
            "path": "ai/shared/skills/",
            "description": "Agent skill modules",
            "resources": [
                {
                    "name": "code-generation",
                    "file": "code-generation.json",
                    "type": "skill",
                    "providers": ["all"],
                    "description": "Code generation skill with best practices"
                }
            ]
        },
        "models": {
            "path": "ai/shared/models/",
            "description": "Model adapters and configs",
            "resources": [
                {
                    "name": "qwen2.5-7b-instruct",
                    "file": "qwen2.5-7b-instruct.json",
                    "type": "model",
                    "providers": ["local"],
                    "description": "Qwen2.5 7B Instruct model configuration"
                }
            ]
        },
        "resources": {
            "path": "ai/shared/resources/",
            "description": "Configuration and data files",
            "resources": [
                {
                    "name": "spec-distribution",
                    "file": "spec-distribution.json",
                    "type": "coordination",
                    "providers": ["all"],
                    "description": "Manages shared spec distribution across all AI providers"
                },
                {
                    "name": "resource-aliases",
                    "file": "resource-aliases.json",
                    "type": "mapping",
                    "providers": ["all"],
                    "description": "Provider-specific name mappings for backward compatibility"
                },
                {
                    "name": "resource-mapping",
                    "file": "resource-mapping.json",
                    "type": "mapping",
                    "providers": ["all"],
                    "description": "Unified resource mapping across providers"
                },
                {
                    "name": "collaborative-reasoning",
                    "file": "collaborative-reasoning.yaml",
                    "type": "configuration",
                    "providers": ["all"],
                    "description": "Multi-provider collaborative reasoning configuration"
                },
                {
                    "name": "task-distribution",
                    "file": "task-distribution.yaml",
                    "type": "configuration",
                    "providers": ["all"],
                    "description": "Task distribution across AI providers"
                }
            ]
        },
        "schemas": {
            "path": "ai/shared/resources/schema/",
            "description": "Database schemas",
            "resources": [
                {
                    "name": "execution-memory-schema",
                    "file": "execution-memory.sql",
                    "type": "schema",
                    "description": "SQLite schema for shared provider execution memory"
                }
            ]
        }
    },
    "executionMemory": {
        "enabled": true,
        "path": "ai/shared/resources/execution-memory.db",
        "schema": "ai/shared/resources/schema/execution-memory.sql",
        "features": [
            "context_sharing",
            "reasoning_state",
            "parallel_task_distribution",
            "provider_state_sync",
            "conversation_history",
            "audit_logging"
        ]
    },
    "validation": {
        "onRegistration": true,
        "checkDuplicates": true,
        "validateSchema": true
    }
}
