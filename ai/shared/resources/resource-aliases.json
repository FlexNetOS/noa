{
  "$schema": "https://noa.local/schemas/resource-aliases.json",
  "version": "1.0.0",
  "description": "Maintains backward-compatible aliases for provider-specific resource names (§4.10)",
  "lastUpdated": "2025-12-08T00:00:00Z",
  "aliases": {
    "agents": {
      "claude": "reasoning-agent",
      "codex": "code-generation-agent",
      "copilot-chat": "inline-completion-agent",
      "cursor-agent": "orchestration-agent"
    },
    "tools": {
      "claude-reasoning": "reasoning-tool",
      "codex-generate": "code-generation-tool"
    },
    "commands": {},
    "prompts": {},
    "workflows": {}
  },
  "deprecationWarnings": {
    "enabled": true,
    "message": "Direct provider-specific access is deprecated. Use unified name: {unified}",
    "logLevel": "warn"
  },
  "resolution": {
    "priority": ["unified", "alias"],
    "fallback": "error"
  }
}

