{
  "$schema": "https://noa.local/schemas/model-config.json",
  "id": "gemma-3-4b-qat",
  "name": "Gemma 3 4B QAT",
  "version": "1.0.0",
  "description": "Google Gemma 3 4B with Quantization-Aware Training - High quality compact model",
  "family": "gemma3",
  "size": "4b",
  "quantization": "Q4_K_XL",
  "provider": "local",
  "backend": "llama.cpp",
  "source": {
    "publisher": "unsloth",
    "original": "google/gemma-3-4b-it-qat",
    "license": "gemma"
  },
  "file": {
    "name": "gemma-3-4b-it-qat-UD-Q4_K_XL.gguf",
    "size_bytes": 3000000000,
    "sha256": null,
    "download_url": "https://huggingface.co/unsloth/gemma-3-4b-it-qat-GGUF/resolve/main/gemma-3-4b-it-qat-UD-Q4_K_XL.gguf"
  },
  "capabilities": {
    "chat": true,
    "completion": true,
    "embedding": false,
    "function_calling": false,
    "vision": false,
    "code": true,
    "reasoning": true
  },
  "parameters": {
    "context_length": 8192,
    "max_output_tokens": 4096,
    "temperature_default": 1.0,
    "top_p_default": 0.95,
    "top_k_default": 64,
    "min_p_default": 0.0
  },
  "chat_template": {
    "format": "gemma",
    "bos_token": "<bos>",
    "user_prefix": "<start_of_turn>user\n",
    "user_suffix": "<end_of_turn>\n",
    "assistant_prefix": "<start_of_turn>model\n",
    "assistant_suffix": "<end_of_turn>\n"
  },
  "recommended_for": [
    "general_chat",
    "code_generation",
    "balanced_performance",
    "edge_deployment"
  ],
  "memory_requirements": {
    "minimum_vram_gb": 4,
    "recommended_vram_gb": 6,
    "cpu_fallback": true,
    "cpu_threads_recommended": 8
  },
  "metadata": {
    "author": "Google DeepMind",
    "release_date": "2025-03",
    "noa_added": "2025-12-17",
    "tags": ["qat", "gemma", "instruct", "quantized"]
  }
}
