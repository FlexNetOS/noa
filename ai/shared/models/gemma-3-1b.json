{
  "$schema": "https://noa.local/schemas/model-config.json",
  "id": "gemma-3-1b",
  "name": "Gemma 3 1B",
  "version": "1.0.0",
  "description": "Google Gemma 3 1B - Compact instruction-tuned model for lightweight deployment",
  "family": "gemma3",
  "size": "1b",
  "quantization": "BF16",
  "provider": "local",
  "backend": "llama.cpp",
  "constitutional_slm": true,
  "source": {
    "publisher": "unsloth",
    "original": "google/gemma-3-1b-it",
    "license": "gemma"
  },
  "file": {
    "name": "gemma-3-1b-it-BF16.gguf",
    "size_bytes": 2000000000,
    "sha256": null,
    "download_url": "https://huggingface.co/unsloth/gemma-3-1b-it-GGUF/resolve/main/gemma-3-1b-it-BF16.gguf"
  },
  "capabilities": {
    "chat": true,
    "completion": true,
    "embedding": false,
    "function_calling": false,
    "vision": false,
    "code": true,
    "reasoning": false
  },
  "parameters": {
    "context_length": 8192,
    "max_output_tokens": 4096,
    "temperature_default": 1.0,
    "top_p_default": 0.95,
    "top_k_default": 64,
    "min_p_default": 0.0
  },
  "chat_template": {
    "format": "gemma",
    "bos_token": "<bos>",
    "user_prefix": "<start_of_turn>user\n",
    "user_suffix": "<end_of_turn>\n",
    "assistant_prefix": "<start_of_turn>model\n",
    "assistant_suffix": "<end_of_turn>\n"
  },
  "recommended_for": [
    "lightweight_chat",
    "edge_deployment",
    "mobile",
    "simple_tasks"
  ],
  "memory_requirements": {
    "minimum_vram_gb": 2,
    "recommended_vram_gb": 3,
    "cpu_fallback": true,
    "cpu_threads_recommended": 4
  },
  "metadata": {
    "author": "Google DeepMind",
    "release_date": "2025-03",
    "noa_added": "2025-12-17",
    "tags": ["compact", "gemma", "instruct", "lightweight"]
  }
}
