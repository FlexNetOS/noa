{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NKAL Capability Grants",
  "description": "Capability grant schema for the NOA Kernel Abstraction Layer (T835). Defines which operations are allowed per kernel mode and provider.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "default": "1.0.0"
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Named capabilities allowed in this mode (e.g., fs.read, fs.write, net.outbound.local, net.outbound.remote, process.spawn, container.run)"
          },
          "denies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Explicit denials that override capabilities."
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "capabilities": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "denies": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["capabilities"]
            },
            "description": "Per-provider capability overrides."
          }
        },
        "required": ["capabilities"]
      },
      "description": "Capability grants keyed by kernel mode (native, vm, container, sandbox)."
    }
  },
  "required": ["version", "modes"],
  "examples": [
    {
      "version": "1.0.0",
      "modes": {
        "native": {
          "capabilities": ["fs.read", "fs.write", "process.spawn", "net.outbound.local"],
          "denies": ["net.outbound.remote", "container.run"]
        },
        "sandbox": {
          "capabilities": ["fs.read", "process.spawn"],
          "denies": ["fs.write", "net.outbound.remote", "container.run"]
        },
        "container": {
          "capabilities": ["fs.read", "fs.write", "process.spawn", "net.outbound.local", "net.outbound.remote", "container.run"],
          "providers": {
            "llama": { "capabilities": ["gpu.access"], "denies": [] }
          }
        },
        "vm": {
          "capabilities": ["fs.read", "fs.write", "process.spawn", "net.outbound.local", "net.outbound.remote", "container.run", "vm.manage"]
        }
      }
    }
  ]
}
