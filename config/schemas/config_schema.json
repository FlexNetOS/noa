{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noa.local/schemas/config_schema.json",
  "title": "NOA Unified Configuration Schema",
  "description": "Schema for validating all NOA configuration files with rich metadata support",
  "version": "1.0.0",
  
  "definitions": {
    "metadata": {
      "type": "object",
      "description": "Standard metadata for all configuration entities",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
          "description": "Semantic version of the configuration"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (ISO8601)"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "created_by": {
          "type": "string",
          "description": "Creator identity (user or agent)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Classification tags"
        },
        "lineage": {
          "$ref": "#/definitions/lineage"
        }
      },
      "required": ["version"]
    },
    
    "lineage": {
      "type": "object",
      "description": "Provenance tracking for configuration changes",
      "properties": {
        "parent_version": {
          "type": "string",
          "description": "Previous version this derived from"
        },
        "change_type": {
          "type": "string",
          "enum": ["create", "update", "derive", "merge"],
          "description": "Type of change"
        },
        "change_reason": {
          "type": "string",
          "description": "Reason for the change"
        },
        "source_file": {
          "type": "string",
          "description": "Source file path if derived"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 content hash"
        }
      }
    },
    
    "env_reference": {
      "type": "string",
      "pattern": "^\\$\\{[A-Z_][A-Z0-9_]*\\}$",
      "description": "Environment variable reference (e.g., ${NOA_ROOT})"
    },
    
    "path": {
      "oneOf": [
        { "type": "string", "format": "uri-reference" },
        { "$ref": "#/definitions/env_reference" }
      ],
      "description": "File path or URI, may contain env vars"
    },
    
    "provider_config": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "type": {
          "type": "string",
          "enum": ["local", "cloud", "hybrid", "ide"]
        },
        "interface": {
          "type": "string",
          "enum": ["cli", "api", "ide", "cloud"]
        },
        "config_path": { "$ref": "#/definitions/path" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rate_limits": {
          "type": "object",
          "properties": {
            "requests_per_minute": { "type": "integer" },
            "tokens_per_minute": { "type": "integer" }
          }
        }
      },
      "required": ["type"]
    },
    
    "database_config": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["sqlite", "postgresql"]
        },
        "path": { "$ref": "#/definitions/path" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "password": { "$ref": "#/definitions/env_reference" },
        "settings": {
          "type": "object",
          "additionalProperties": true
        },
        "max_connections": { "type": "integer", "minimum": 1 }
      },
      "required": ["driver"]
    },
    
    "agent_definition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z]+Agent$"
        },
        "type": {
          "type": "string",
          "enum": ["permanent", "board", "stack", "dynamic"]
        },
        "version": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "config": { "type": "object" },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "parent_id": { "type": "string", "format": "uuid" }
      },
      "required": ["name", "type", "version", "capabilities"]
    },
    
    "feature_flag": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "scope": {
          "type": "string",
          "enum": ["global", "user", "agent", "device"]
        },
        "conditions": {
          "type": "object",
          "additionalProperties": true
        },
        "rollout_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["name", "enabled"]
    }
  },
  
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "metadata": { "$ref": "#/definitions/metadata" },
    
    "noa_root": { "$ref": "#/definitions/path" },
    
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/provider_config" }
    },
    
    "database": { "$ref": "#/definitions/database_config" },
    
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/agent_definition" }
    },
    
    "feature_flags": {
      "type": "array",
      "items": { "$ref": "#/definitions/feature_flag" }
    },
    
    "shared_resources": {
      "type": "object",
      "properties": {
        "agents": { "$ref": "#/definitions/path" },
        "prompts": { "$ref": "#/definitions/path" },
        "tools": { "$ref": "#/definitions/path" },
        "workflows": { "$ref": "#/definitions/path" },
        "models": { "$ref": "#/definitions/path" }
      }
    },
    
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "format": {
          "type": "string",
          "enum": ["json", "text", "pretty"]
        },
        "output": { "$ref": "#/definitions/path" }
      }
    }
  }
}




