{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noa.local/schemas/shared-resources.json",
  "title": "NOA Shared Resources Configuration Schema",
  "description": "Schema for NOA shared resources configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "metadata": {
      "type": "object",
      "description": "Standard metadata for configuration",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
          "description": "Semantic version of the configuration"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (ISO8601)"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "created_by": {
          "type": "string",
          "description": "Creator identity (user or agent)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        }
      },
      "required": ["version"]
    },
    "basePath": { "type": "string" },
    "directories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "description": { "type": "string" },
          "format": { "type": "string" }
        }
      }
    }
  },
  "required": ["basePath", "directories"]
}