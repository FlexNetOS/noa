{
    "$id": "https://noa.local/schemas/desktop-apps.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NOA Desktop Applications",
    "description": "Schema for desktop application containment and launcher configuration",
    "type": "object",
    "required": ["metadata", "apps"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "metadata": {
            "type": "object",
            "description": "Standard metadata for configuration",
            "properties": {
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
                    "description": "Semantic version of the configuration"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Creation timestamp (ISO8601)"
                },
                "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Last modification timestamp"
                },
                "created_by": {
                    "type": "string",
                    "description": "Creator identity (user or agent)"
                },
                "description": {
                    "type": "string",
                    "description": "Human-readable description"
                }
            },
            "required": ["version"]
        },
        "proxy": {
            "type": "object",
            "description": "Global proxy defaults",
            "properties": {
                "host": { "type": "string", "default": "127.0.0.1" },
                "port": { "type": "integer", "default": 8085 },
                "rulesDirectory": { "type": "string" }
            },
            "additionalProperties": false
        },
        "apps": {
            "type": "array",
            "description": "List of desktop apps managed by NDCL",
            "items": {
                "type": "object",
                "required": ["id", "name", "installPath", "executable", "dataPath"],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Stable slug for the app (e.g., chatgpt, claude, github-desktop)",
                        "pattern": "^[a-z0-9-]+$"
                    },
                    "name": {
                        "type": "string",
                        "description": "Human friendly app name"
                    },
                    "installPath": {
                        "type": "string",
                        "description": "Absolute path to the installation root"
                    },
                    "executable": {
                        "type": "string",
                        "description": "Executable file name or relative path from installPath"
                    },
                    "dataPath": {
                        "type": "string",
                        "description": "Path where user data is redirected (usually under ${NOA_DATA}/apps/<app>)"
                    },
                    "networkIsolation": {
                        "type": "object",
                        "description": "Network controls for the app",
                        "properties": {
                            "enabled": { "type": "boolean", "default": true },
                            "proxyProfile": { "type": "string" },
                            "rulesFile": { "type": "string" },
                            "p2pRouting": { "type": "boolean", "default": false },
                            "rateLimitRps": { "type": "number" }
                        },
                        "additionalProperties": false
                    },
                    "gpuEnabled": {
                        "type": "boolean",
                        "description": "Allow GPU acceleration inside the containment layer",
                        "default": true
                    },
                    "autoUpdate": {
                        "type": "boolean",
                        "description": "Whether to allow the app to self-update",
                        "default": false
                    },
                    "launchWrapper": {
                        "type": "string",
                        "description": "Path to the wrapper script used to start the app"
                    },
                    "env": {
                        "type": "object",
                        "description": "Extra environment variables injected at launch",
                        "additionalProperties": { "type": "string" }
                    },
                    "notes": {
                        "type": "string",
                        "description": "Operational notes or constraints"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
