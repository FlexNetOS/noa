{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noa.local/schemas/governance.json",
  "title": "NOA Governance Decision Schema",
  "description": "Schema for validating governance decisions, rule verdicts, and audit events (FR-025 to FR-028)",
  "type": "object",

  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "rule_verdict": {
      "type": "object",
      "properties": {
        "rule": { "type": "string", "description": "Rule name" },
        "verdict": {
          "type": "string",
          "enum": ["allow", "deny", "escalate", "requireRollback"]
        },
        "rationale": { "type": "string" },
        "principles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reward_delta": { "type": "number" },
        "requires_snapshot": { "type": "boolean" },
        "evidence": { "type": "object", "additionalProperties": true }
      },
      "required": ["rule", "verdict", "rationale"]
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "agent_id": { "type": "string" },
        "action": { "type": "string" },
        "rationale": { "type": "string" },
        "context": { "type": "object", "additionalProperties": true },
        "principles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "agent_id", "action", "rationale", "created_at"]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "decision_id": { "$ref": "#/definitions/uuid" },
        "agent_id": { "type": "string" },
        "final_verdict": {
          "type": "string",
          "enum": ["allow", "deny", "escalate", "requireRollback"]
        },
        "rule_verdicts": {
          "type": "array",
          "items": { "$ref": "#/definitions/rule_verdict" }
        },
        "reward_delta": { "type": "number" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "escalation_target": { "type": "string" },
        "snapshot_hint": { "type": "string" }
      },
      "required": ["decision_id", "agent_id", "final_verdict", "recorded_at"]
    }
  },

  "properties": {
    "decision": { "$ref": "#/definitions/decision" },
    "outcome": { "$ref": "#/definitions/outcome" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "audit_path": { "type": "string", "description": "Path to persisted audit ledger" },
    "biblical_support": {
      "type": "array",
      "description": "Referenced biblical sources that support the decision",
      "items": { "type": "string" }
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the decision context for tamper detection"
    }
  },

  "required": ["decision", "outcome", "recorded_at"]
}
