{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noa.local/schemas/bootstrap-state.json",
  "title": "NOA Bootstrap State Schema",
  "description": "Schema for validating NOA bootstrap state configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Standard metadata for configuration",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
          "description": "Semantic version of the configuration"
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Creation timestamp (ISO8601)"
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "created_by": {
          "type": "string",
          "description": "Creator identity (user or agent)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        }
      },
      "required": ["version"]
    },
    "bootstrap_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": { "type": ["string", "null"] },
        "arch": { "type": ["string", "null"] },
        "shell": { "type": ["string", "null"] },
        "is_wsl": { "type": "boolean" },
        "wsl_version": { "type": "number" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "path": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "installed", "updated", "failed", "skipped", "configured"] },
          "installed_at": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "root_path": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "installed", "updated", "failed", "skipped", "configured"] },
          "installed_at": { "type": "string", "format": "date-time" },
          "env_vars": { "type": "object" },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "config_path": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "installed", "updated", "failed", "skipped", "configured"] },
          "installed_at": { "type": "string", "format": "date-time" },
          "priority": { "type": "string" }
        }
      }
    },
    "_schema": {
      "type": "object",
      "properties": {
        "tools": { "type": "object" },
        "toolchains": { "type": "object" },
        "providers": { "type": "object" },
        "status_values": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["bootstrap_version", "platform", "tools", "toolchains", "providers"]
}