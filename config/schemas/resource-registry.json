{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noa.local/schemas/resource-registry.json",
  "title": "NOA Shared Resource Registry",
  "description": "Schema for the unified registry of shared AI resources",
  "type": "object",
  "required": ["version", "registry"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "description": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": { "$ref": "#/$defs/registryEntry" },
        "tools": { "$ref": "#/$defs/registryEntry" },
        "commands": { "$ref": "#/$defs/registryEntry" },
        "prompts": { "$ref": "#/$defs/registryEntry" },
        "workflows": { "$ref": "#/$defs/registryEntry" },
        "skills": { "$ref": "#/$defs/registryEntry" },
        "models": { "$ref": "#/$defs/registryEntry" },
        "resources": { "$ref": "#/$defs/registryEntry" },
        "schemas": { "$ref": "#/$defs/registryEntry" }
      }
    },
    "executionMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "schema": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onRegistration": { "type": "boolean" },
        "checkDuplicates": { "type": "boolean" },
        "validateSchema": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["name", "file"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "file": { "type": "string" },
        "type": { "type": "string" },
        "providers": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "description": { "type": "string" }
      }
    },
    "registryEntry": {
      "type": "object",
      "required": ["path", "description"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "description": { "type": "string" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    }
  }
}
