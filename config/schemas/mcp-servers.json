{
    "$id": "https://noa.local/schemas/mcp-servers.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NOA MCP Servers Configuration",
    "description": "Schema for Model Context Protocol (MCP) server configurations",
    "type": "object",
    "required": ["version", "servers"],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Optional schema reference for JSON consumers"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
            "description": "Semantic version of the MCP servers configuration"
        },
        "servers": {
            "type": "object",
            "description": "MCP server configurations keyed by server name",
            "additionalProperties": {
                "type": "object",
                "required": ["command"],
                "properties": {
                    "command": {
                        "type": "string",
                        "description": "Command to execute the MCP server (e.g., 'npx', '/path/to/server')"
                    },
                    "args": {
                        "type": "array",
                        "description": "Command-line arguments passed to the server command",
                        "items": {
                            "type": "string"
                        },
                        "default": []
                    },
                    "requiredEnv": {
                        "type": "array",
                        "description": "Required environment variable names that must be set for this server",
                        "items": {
                            "type": "string",
                            "pattern": "^[A-Z_][A-Z0-9_]*$"
                        },
                        "default": []
                    },
                    "env": {
                        "type": "object",
                        "description": "Additional environment variables to set for this server",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}

