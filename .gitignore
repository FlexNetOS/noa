# Node modules and dependencies
node_modules/
**/node_modules/

# Python virtual environments
venv/
.venv/
__pycache__/
*.pyc

# All opt/ directories (portable toolchains, installers, user-specific tools)
# Note: Submodules in opt/ (e.g., opt/llama.cpp/) are tracked separately via .gitmodules
opt/
opt/**

# Centralized caches (regenerated, per-machine)
cache/
cache/**

# npm cache
opt/npm-cache/

# Large local directories are now tracked as git submodules
# opt/llama.cpp/ - tracked as submodule pointing to FlexNetOS/llama.cpp
# opt/llama-cpp-rs/ - tracked as submodule pointing to FlexNetOS/llama-cpp-rs

# Downloaded binaries (platform-specific, download via scripts/download-static-binaries.ps1)
bin/*.exe
bin/jq
bin/rg
bin/fd
bin/bat

# Local lib directory (bundled libraries)
lib/
# Exception: allow sys/ui/src/lib (TypeScript library code)
!sys/ui/src/lib/

# Build outputs
dist/
build/
out/

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
setup-log.txt

# Backup files
*.backup
*.bak
*.old

# Test results
*.TestResults.xml
TestResults.xml

# Temporary and test files
test-*.ps1
test-*.txt
test-*.bat
create-*.ps1
create-*.bat

# IDE and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vs/
.vscode/
.cursor/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE workspace files (user-specific)
*.code-workspace
.cursor-server/
.cursor-tuning/

# Generated files (will be created by setup script)
noa-profile.ps1
.noa
Z:/
tmp/

# Rust build artifacts
target/
**/target/

# Debug build artifacts
**/target/debug/
**/target/release/
*.pdb
*.ilk
*.obj
*.o
*.d
*.rlib
*.rmeta
*.exe
*.dll
*.so
*.dylib

# Next.js build artifacts
.next/
**/.next/
tsconfig.tsbuildinfo
