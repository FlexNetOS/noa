# Node modules and dependencies
node_modules/
**/node_modules/

# Python virtual environments
opt/venv/
venv/
.venv/
__pycache__/
*.pyc

# Local tool installations (should not be committed)
opt/nodejs/
opt/*.exe

# Dev tools installed by bootstrap (gitignored, user-specific)
opt/dev-tools/
opt/dev-tools/**

# Portable toolchains installed to noa_root
opt/rust/
opt/go/
opt/node/
opt/python/
opt/protobuf/

# Python venv (per-user)
opt/venv/

# Centralized caches (regenerated, per-machine)
cache/
cache/**

# npm cache
opt/npm-cache/

# Large local directories are now tracked as git submodules
# opt/llama.cpp/ - tracked as submodule pointing to FlexNetOS/llama.cpp
# opt/llama-cpp-rs/ - tracked as submodule pointing to FlexNetOS/llama-cpp-rs

# Downloaded binaries (platform-specific, download via scripts/download-static-binaries.ps1)
bin/*.exe
bin/jq
bin/rg
bin/fd
bin/bat

# Local lib directory (bundled libraries)
lib/

# Build outputs
dist/
build/
out/

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
setup-log.txt

# Backup files
*.backup
*.bak
*.old

# Test results
*.TestResults.xml
TestResults.xml

# Temporary and test files
test-*.ps1
test-*.txt
test-*.bat
create-*.ps1
create-*.bat

# IDE and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vs/
.vscode/
.cursor/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE workspace files (user-specific)
*.code-workspace
.cursor-server/
.cursor-tuning/

# Generated files (will be created by setup script)
noa-profile.ps1
.noa
Z:/
tmp/
