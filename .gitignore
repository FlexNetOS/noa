# Node modules and dependencies
node_modules/
**/node_modules/

# Python virtual environments
venv/
.venv/
__pycache__/
*.pyc

# All opt/ directories (portable toolchains, installers, user-specific tools)
# Note: Submodules in opt/ (e.g., opt/llama.cpp/) are tracked separately via .gitmodules
opt/
opt/**

# Centralized caches (regenerated, per-machine)
cache/
cache/**

# npm cache
opt/npm-cache/

# Large local directories are now tracked as git submodules
# opt/llama.cpp/ - tracked as submodule pointing to FlexNetOS/llama.cpp
# opt/llama-cpp-rs/ - tracked as submodule pointing to FlexNetOS/llama-cpp-rs

# Downloaded binaries (platform-specific, download via scripts/download-static-binaries.ps1)
bin/*.exe
bin/jq
bin/rg
bin/fd
bin/bat

# Local lib directory (bundled libraries)
lib/

# Build outputs
dist/
build/
out/

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
setup-log.txt

# Backup files
*.backup
*.bak
*.old

# Test results
*.TestResults.xml
TestResults.xml

# Local environment files (never commit secrets)
.env
.env.*
!.env.example

# Jest coverage output (generated)
coverage/
**/coverage/

# Temporary and test files
test-*.ps1
test-*.txt
test-*.bat
create-*.ps1
create-*.bat

# IDE and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vs/
.vscode/
.cursor/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local AI/agent state (user-specific)
.claude/settings.local.json
.claude/settings.local.*

# Local app/IDE state (user-specific)
# NOTE: These files can contain machine-specific settings and should not be committed.
data/state/.copilot/
data/state/pnpm/
data/state/pnpm/**
etc/.copilot/
etc/configstore/
data/appdata/local/
data/appdata/local/**
data/appdata/roaming/Code/
data/appdata/roaming/AbacusAI/
data/appdata/roaming/Python/
data/appdata/roaming/Python/**

# Go telemetry (local, user-specific)
data/appdata/roaming/go/telemetry/
data/appdata/roaming/go/telemetry/**

# Local inference models (very large; keep out of git history)
*.gguf
ml_devops_platform/rust_backend/models/
ml_devops_platform/rust_backend/models/**

# Playwright artifacts (generated)
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# Local dev databases (generated)
prisma/dev.db
**/prisma/dev.db

# NOA sqlite database (generated)
sys/core/data/noa.db
sys/core/data/noa.db-*
sys/core/data/*.db
sys/core/data/*.db-*
*.db-wal
*.db-shm

# IDE workspace files (user-specific)
*.code-workspace
.cursor-server/
.cursor-tuning/

# Generated files (will be created by setup script)
noa-profile.ps1
.noa
Z:/
tmp/

# Rust build artifacts
target/
**/target/

# Next.js build artifacts
.next/
**/.next/
tsconfig.tsbuildinfo
